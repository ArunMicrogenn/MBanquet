rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Admin';
    }

    // Rules for users collection
    match /users/{userId} {
      // Anyone can read their own profile, Admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only Admins can create/update roles, except for initial setup (if no users exist)
      // Allow create if they are authenticating for the first time
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // Rules for date_closures collection
    match /date_closures/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rules for daily_audits collection
    match /daily_audits/{id} {
      allow read, write: if isAuthenticated();
    }
    
    // Default rule for everything else: Admins can do anything, others read-only for now
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
